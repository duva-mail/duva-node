# Ce dépôt EST un environnement de développement (bibliothèque cliente) : les devDependencies
# (TypeScript, Vitest, tsup, openapi-typescript...) sont nécessaires pour construire et tester,
# jamais pour l'exécution du paquet publié. Sans ce fichier, sous NODE_ENV=production, `npm install`
# omet silencieusement les devDependencies (comportement documenté de npm) et les scripts
# "generate"/"build"/"test" échouent avec « command not found ».
production=false
